{
  "name": "sat-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Was fliegt da über uns? Satelliten-Tracker für den Workshop „Webanwendungen mit Claude Code entwickeln“",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "stop": "node scripts/stop.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "check-setup": "node scripts/check-setup.mjs",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "tests:lock": "node -e \"require('fs').writeFileSync('.claude/tests-locked','')\" && echo Tests gesperrt",
    "tests:unlock": "node -e \"require('fs').rmSync('.claude/tests-locked',{force:true})\" && echo Tests entsperrt",
    "check-orbit": "tsx scripts/check-orbit.ts",
    "e2e": "playwright test",
    "migrate:panels": "node scripts/migrate-panels.mjs",
    "ai:changelog": "node scripts/changelog.mjs",
    "ai:commit-msg": "git diff --staged | claude -p \"Schreib eine Commit-Nachricht für diesen Diff: Betreffzeile auf Deutsch, höchstens 72 Zeichen, danach optional Stichpunkte. Nur die Nachricht ausgeben.\" --max-turns 1",
    "ai:review": "git diff main...HEAD | claude -p \"Reviewe diesen Diff nach .claude/agents/reviewer.md. Nur Befunde, schwerwiegendste zuerst.\" --allowedTools Read Grep Glob --max-turns 10"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "express": "^5.3.0",
    "globe.gl": "^2.46.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astronomy-engine": "^2.1.19",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
