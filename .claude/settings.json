{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(npm run verify:*)",
            "Bash(npm run typecheck:*)",
            "Bash(npm run lint:*)",
            "Bash(npm test:*)",
            "Bash(npm run test:*)",
            "Bash(npx vitest run:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(node .claude/skills/new-endpoint/check-endpoint.mjs:*)",
            "Bash(npm run check-orbit:*)"
        ],
        "ask": [
            "Bash(git push:*)",
            "Bash(npm install:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Edit(./.env)",
            "Edit(./fixtures/**)",
            "WebFetch(domain:celestrak.org)",
            "Bash(npm run fetch-data:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-tests.mjs\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.mjs\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
                        "timeout": 180
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-metrics.mjs\""
                    }
                ]
            }
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline.mjs\""
    }
}
